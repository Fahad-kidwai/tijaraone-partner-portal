# Copy to .env.local (local) or set in Netlify (production). NEVER commit real values.
# Locally these are populated by: neon login && neon deploy  (or `neon env pull`)

# Neon Postgres (written by `neon env pull` — do not rename):
# Pooled connection (host contains "-pooler") — app runtime traffic via Prisma + Neon serverless driver
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct/unpooled connection — Prisma Migrate only (schema.prisma directUrl)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# Written by Neon CLI; identifies the checked-out branch
NEON_BRANCH=""

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-at-least-32-random-chars"
OTP_PEPPER="replace-with-at-least-32-random-chars"

# Trusted client-IP header set by the host (rate limiting). Default x-nf-client-connection-ip (Netlify).
# Set this to whatever header the production host injects for the real client IP
# (e.g. cf-connecting-ip on Cloudflare). Client-spoofable headers (x-forwarded-for)
# are never trusted in production. If the header is absent in production, the
# per-IP OTP limit is skipped (per-email limits still apply) and a warning is
# logged once per process — never a shared "unknown" bucket.
CLIENT_IP_HEADER=""

# Email (Phase 1+). EMAIL_DRIVER=console logs instead of sending (dev only).
EMAIL_DRIVER="console"
RESEND_API_KEY=""
# Use your verified sending domain in real env — example.com is a placeholder only.
EMAIL_FROM="Portal <no-reply@example.com>"
APP_URL="http://localhost:3000"
