{
  "name": "tijaraone-partner-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:all": "npm test && npm run test:slow",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed.ts --dev-fixtures",
    "db:reset:dev": "tsx scripts/dev-reset.ts",
    "prune:otp": "tsx scripts/prune-otp.ts",
    "db:check": "tsx scripts/check-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "bufferutil": "^4.1.0",
    "jose": "^6.2.13",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.57.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.34.1",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
